# Copy this file to .env and fill in the values.
# CLUSTER_SECRET must be IDENTICAL across every peer in the cluster.
# Never commit the real .env to git.

# --- Shared across all peers (set via secrets management) ---
# Generate once with:
#   od -vN 32 -An -tx1 /dev/urandom | tr -d ' \n'
CLUSTER_SECRET=

# --- Coordinator only ---
# Peer ID of this coordinator. REQUIRED for coordinator setup.
# Used by CLUSTER_CRDT_TRUSTEDPEERS to restrict CRDT pin operations to this
# peer only, and used to patch trusted_peers + pin_only_on_trusted_peers in
# service.json so volunteers cannot produce CRDT writes.
# Get it with: docker exec cluster ipfs-cluster-ctl id
COORDINATOR_PEER_ID=

# --- Tracker (failed-CID sidecar) ---
# How often (seconds) the tracker polls the cluster REST API for pin status.
# Default: 60. Lower = faster error detection, higher = less CPU on large pinsets.
# At 200K CIDs / 4TB the cluster REST /pins call is heavy — keep this at 60+
# to avoid hammering the cluster.
# Relevant for track-failed-cids.py (SERVE_PORT / STATE_FILE / MAX_RETRIES
# are configured via environment in docker-compose.tracker.yml).
# POLL_INTERVAL_SECONDS=60

# --- Storage (all peers) ---
# Kubo's default storage ceiling is ~10GB. Raise it so peers can actually
# host the allocations the cluster assigns. E.g. 4TB, 500GB, 50GB.
# Leave empty to use the 4TB default.
IPFS_STORAGE_MAX=

# Unique peer name for this instance, e.g. my-coordinator
CLUSTER_PEERNAME=my-coordinator

# Leave empty on the first (seed) peer.
# For volunteers, set to the seed peer's multiaddr:
#   /ip4/<seed-public-ip>/tcp/9096/p2p/<seed-peer-id>
BOOTSTRAP_PEERS=

# Only needed for peers behind NAT. Advertise your public or Tailscale IP
# so the coordinator can open direct connections for CRDT sync and metrics.
# CLUSTER_PEER_ADDRESSES=/ip4/<your-public-ip>/tcp/9096